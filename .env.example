# Google Cloud project configuration
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Gemini model selection
SUPERVISOR_MODEL=gemini-2.5-flash
RAG_MODEL=gemini-2.5-flash
ACTION_MODEL=gemini-2.5-flash
POLICY_MODEL=gemini-2.5-pro

# Agent Search / RAG Engine
AGENT_SEARCH_ENGINE_ID=your-engine-id
RAG_CORPUS_NAME=projects/your-project/locations/us-central1/ragCorpora/your-corpus

# Vector Search (if using custom retrieval)
VECTOR_SEARCH_INDEX_ENDPOINT=your-endpoint
VECTOR_SEARCH_DEPLOYED_INDEX_ID=your-deployed-index

# Application
APP_NAME=enterprise-multi-agent
LOG_LEVEL=INFO
