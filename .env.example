# Google Cloud project configuration
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Required: tells ADK to use Vertex AI (not AI Studio)
GOOGLE_GENAI_USE_ENTERPRISE=1

# Gemini model selection
SUPERVISOR_MODEL=gemini-2.5-flash
RAG_MODEL=gemini-2.5-flash
ACTION_MODEL=gemini-2.5-flash
POLICY_MODEL=gemini-2.5-pro

# Retrieval backend: agent_search | rag_engine | vector_search
RETRIEVAL_BACKEND=agent_search

# Agent Search (required when RETRIEVAL_BACKEND=agent_search)
AGENT_SEARCH_ENGINE_ID=your-engine-id

# RAG Engine (required when RETRIEVAL_BACKEND=rag_engine)
RAG_CORPUS_NAME=projects/your-project/locations/us-central1/ragCorpora/your-corpus

# Vector Search (required when RETRIEVAL_BACKEND=vector_search)
VECTOR_SEARCH_INDEX_ENDPOINT=your-endpoint
VECTOR_SEARCH_DEPLOYED_INDEX_ID=your-deployed-index

# Application
APP_NAME=enterprise-multi-agent
LOG_LEVEL=INFO
